#include <M5Unified.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include "DHT.h"
#include "secrets.h"

// Configurações do Broker MQTT Seguro
const char* mqtt_server = MQTT_SERVER;
const int mqtt_port = MQTT_PORT_SECURE;
const char* mqtt_user = MQTT_USER;
const char* mqtt_pass = MQTT_PASSWORD;
const char* mqtt_topic = "extensao/iot/estacao";

// Configuração do Sensor DHT22 (Temperatura e Umidade)
#define DHTPIN 26     
#define DHTTYPE DHT22   
DHT dht(DHTPIN, DHTTYPE);

// Configuração do Sensor HC-SR04 (Alagamento / Nível de Água)
#define TRIG_PIN 32
#define ECHO_PIN 33
#define SOUND_SPEED 0.034

WiFiClientSecure espClient;
PubSubClient client(espClient);

unsigned long lastMsg = 0;

// Função para atualizar mensagens na tela do M5Stick de forma limpa
void atualizarTela(String status, float t, float h, float dist, bool mqttStatus) {
    M5.Display.fillScreen(BLACK);
    M5.Display.setCursor(0, 0);
    M5.Display.setTextSize(1); // Texto menor para caber mais informações
    
    M5.Display.println("--- ESTACAO IoT ---");
    M5.Display.println("Status: " + status);
    M5.Display.println("-------------------");
    M5.Display.printf("Temp: %.1f C\n", t);
    M5.Display.printf("Umid: %.1f %%\n", h);
    M5.Display.printf("Dist: %.1f cm\n", dist);
    M5.Display.println("-------------------");
    if (mqttStatus) {
        M5.Display.println("MQTT: [ENVIANDO OK]");
    } else {
        M5.Display.println("MQTT: [DESCONECTADO]");
    }
}

void setup_wifi() {
    delay(10);
    M5.Display.fillScreen(BLACK);
    M5.Display.setCursor(0, 0);
    M5.Display.setTextSize(1);
    M5.Display.print("Conectando Wi-Fi:\n" + String(WIFI_SSID));

    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    int tentativas = 0;
    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
        M5.Display.print(".");
        tentativas++;
        // Se passar de 20 segundos tentando e não conectar, avisa na tela
        if (tentativas > 40) {
            M5.Display.fillScreen(BLACK);
            M5.Display.setCursor(0, 0);
            M5.Display.println("Erro: Falha Wi-Fi!");
            delay(3000);
            ESP.restart(); // Reinicia o ESP32 para tentar de novo
        }
    }

    Serial.println("\nWiFi conectado! IP: " + WiFi.localIP().toString());
    M5.Display.fillScreen(BLACK);
    M5.Display.setCursor(0, 0);
    M5.Display.println("Wi-Fi Conectado!");
    M5.Display.println("IP:");
    M5.Display.println(WiFi.localIP().toString());
    delay(2000);
}

void reconnect() {
    while (!client.connected()) {
        Serial.print("Tentando conexão MQTTS segura...");
        String clientId = "M5StickC-Debug-";
        clientId += String(random(0xffff), HEX);
        
        if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
            Serial.println("Conectado ao Broker via TLS!");
        } else {
            Serial.print("Falha, rc=");
            Serial.print(client.state());
            Serial.println(" Tentando em 5s...");
            delay(5000);
        }
    }
}

float medirDistancia() {
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    long duration = pulseIn(ECHO_PIN, HIGH, 30000);
    if (duration == 0) return -1.0;
    
    return duration * SOUND_SPEED / 2;
}

void setup() {
    auto cfg = M5.config();
    M5.begin(cfg);
    M5.Display.setRotation(1);
    M5.Display.setTextColor(WHITE);

    Serial.begin(115200);
    dht.begin();
    
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);

    setup_wifi();

    // espClient.setInsecure();
    // client.setServer(mqtt_server, mqtt_port);
}

void loop() {
    M5.update();

    // COMENTE ESTE BLOCO TEMPORARIAMENTE:
    /*
    if (!client.connected()) {
        reconnect();
    }
    client.loop();
    */

    unsigned long now = millis();
    // Coleta e envia a cada 10 segundos
    if (now - lastMsg > 10000) {
        lastMsg = now;

        float h = dht.readHumidity();
        float t = dht.readTemperature();
        float distancia = medirDistancia();

        if (isnan(h) || isnan(t)) {
            Serial.println(F("Falha ao ler o sensor DHT22!"));
            atualizarTela("Erro DHT22", 0, 0, 0, client.connected());
            return;
        }

        // Monta o Payload JSON
        String payload = "{\"device\": \"m5stick-estacao-01\", "
                         "\"temperature\": " + String(t, 1) + ", "
                         "\"humidity\": " + String(h, 1) + ", "
                         "\"water_level_cm\": " + String(distancia, 1) + "}";
        
        // Publica no broker MQTT
        bool enviado = client.publish(mqtt_topic, payload.c_str());
        
        if (enviado) {
            Serial.println("Publicado com sucesso: " + payload);
        } else {
            Serial.println("Erro ao publicar pacote MQTT.");
        }

        // Atualiza a tela com o status completo e o check de envio
        atualizarTela("Rodando OK", t, h, distancia, client.connected());
    }
}